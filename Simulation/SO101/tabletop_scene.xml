<mujoco model="so101_tabletop">
  <!-- ==========================================================================
       SO-101 (with wrist camera) on a realistic tabletop, for keyboard/trackpad
       teleoperation. Companion script: teleop.py
       ========================================================================== -->
  <include file="so101_new_calib_camera.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0.2 0 0.1" extent="0.9" meansize="0.02"/>

  <visual>
    <!-- Keep the headlight as a dim ambient wash; the scene lights do the real work. -->
    <headlight ambient="0.20 0.20 0.22" diffuse="0.12 0.12 0.13" specular="0.05 0.05 0.05"/>
    <quality shadowsize="8192" offsamples="8" numslices="40"/>
    <map force="0.1" zfar="30" shadowclip="0.75" shadowscale="1.0"/>
    <global azimuth="135" elevation="-22" offwidth="1920" offheight="1080"/>
    <rgba haze="0.86 0.88 0.91 1"/>
  </visual>

  <asset>
    <!-- Soft indoor sky: bright near the horizon, cooler overhead. -->
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.62 0.72" rgb2="0.88 0.90 0.93"
             width="512" height="3072"/>

    <texture type="2d" name="wood" file="assets/textures/wood_table.png"/>
    <material name="table_top" texture="wood" texuniform="false" texrepeat="1.35 1.0"
              specular="0.35" shininess="0.45" reflectance="0.04"/>

    <texture type="2d" name="concrete" file="assets/textures/floor_concrete.png"/>
    <material name="floor" texture="concrete" texuniform="true" texrepeat="6 6"
              specular="0.08" shininess="0.1" reflectance="0.02"/>

    <material name="table_frame" rgba="0.16 0.16 0.18 1" specular="0.5" shininess="0.5"/>
    <material name="bowl_mat"    rgba="0.93 0.94 0.96 1" specular="0.7" shininess="0.75" reflectance="0.08"/>
    <material name="cube_red"    rgba="0.78 0.19 0.17 1" specular="0.3" shininess="0.35"/>
    <material name="cube_green"  rgba="0.24 0.55 0.29 1" specular="0.3" shininess="0.35"/>
    <material name="cube_blue"   rgba="0.18 0.36 0.68 1" specular="0.3" shininess="0.35"/>
    <material name="cube_yellow" rgba="0.87 0.68 0.15 1" specular="0.3" shininess="0.35"/>
    <material name="ball_mat"    rgba="0.85 0.45 0.15 1" specular="0.55" shininess="0.6"/>
    <material name="can_mat"     rgba="0.62 0.65 0.70 1" specular="0.9" shininess="0.9" reflectance="0.12"/>
    <material name="mat_target"  rgba="0.1 0.85 0.45 0.55"/>
  </asset>

  <default>
    <!-- Tabletop props: sticky enough to be picked up, damped enough to settle. -->
    <default class="prop">
      <geom condim="4" friction="1.1 0.02 0.004" solimp="0.95 0.99 0.001" solref="0.004 1"
            density="600" group="0"/>
    </default>
    <default class="bowl">
      <geom material="bowl_mat" condim="4" friction="0.9 0.02 0.004"
            solimp="0.95 0.99 0.001" solref="0.004 1" density="900" group="0"/>
    </default>
    <default class="furniture">
      <geom condim="3" friction="0.9 0.02 0.004" group="0"/>
    </default>
  </default>

  <worldbody>
    <!-- ---------------------------------------------------------------- lights -->
    <!-- Key light: front-left, casts the scene's shadows. -->
    <light name="key" mode="fixed" pos="0.34 0.52 0.95" dir="-0.18 -0.52 -1.0"
           directional="false" cutoff="42" exponent="18" castshadow="true"
           diffuse="0.72 0.70 0.66" specular="0.30 0.30 0.28" attenuation="1 0 0.25"/>
    <!-- Fill light: cooler, from the right, no shadows so it only lifts the darks. -->
    <light name="fill" pos="0.15 -1.0 1.0" dir="0.1 0.72 -0.9" directional="true"
           castshadow="false" diffuse="0.26 0.28 0.32" specular="0.04 0.04 0.05"/>
    <!-- Soft overhead ceiling bounce. -->
    <light name="ambient_top" pos="0.15 0 2.2" dir="0 0 -1" directional="true"
           castshadow="false" diffuse="0.22 0.22 0.23" specular="0 0 0"/>
    <!-- Gentle backlight to separate the arm from the background. -->
    <light name="rim" pos="-0.9 0.1 0.7" dir="1 -0.1 -0.35" directional="true"
           castshadow="false" diffuse="0.14 0.15 0.17" specular="0.08 0.08 0.08"/>

    <!-- --------------------------------------------------------------- cameras -->
    <camera name="overview"  pos="0.72  0.78 0.62" xyaxes="-0.74 0.68 0 -0.33 -0.36 0.87"/>
    <camera name="front"     pos="0.95 -0.02 0.34" xyaxes="0 1 0 -0.35 0 0.94"/>
    <camera name="side"      pos="0.18  0.85 0.36" xyaxes="-1 0 0 0 -0.38 0.93"/>
    <camera name="topdown"   pos="0.22  0 0.95"    xyaxes="0 1 0 -1 0 0"/>
    <camera name="operator"  pos="0.60  0.45 0.50" xyaxes="-0.6 0.8 0 -0.48 -0.36 0.80"/>

    <!-- ----------------------------------------------------------------- floor -->
    <geom name="floor" type="plane" pos="0 0 -0.74" size="0 0 0.05"
          material="floor" class="furniture"/>

    <!-- ------------------------------------------------------- table (top @ z=0) -->
    <body name="table" pos="0.15 0 0">
      <geom name="table_top" type="box" pos="0 0 -0.011" size="0.46 0.36 0.011"
            material="table_top" class="furniture"/>
      <!-- apron + legs, so the table reads as a real piece of furniture from any angle -->
      <geom name="apron_x1" type="box" pos="0  0.345 -0.055" size="0.44 0.015 0.033"
            material="table_frame" class="furniture"/>
      <geom name="apron_x2" type="box" pos="0 -0.345 -0.055" size="0.44 0.015 0.033"
            material="table_frame" class="furniture"/>
      <geom name="apron_y1" type="box" pos="  0.445 0 -0.055" size="0.015 0.33 0.033"
            material="table_frame" class="furniture"/>
      <geom name="apron_y2" type="box" pos=" -0.445 0 -0.055" size="0.015 0.33 0.033"
            material="table_frame" class="furniture"/>
      <geom name="leg_1" type="box" pos=" 0.425  0.325 -0.385" size="0.02 0.02 0.353"
            material="table_frame" class="furniture"/>
      <geom name="leg_2" type="box" pos=" 0.425 -0.325 -0.385" size="0.02 0.02 0.353"
            material="table_frame" class="furniture"/>
      <geom name="leg_3" type="box" pos="-0.425  0.325 -0.385" size="0.02 0.02 0.353"
            material="table_frame" class="furniture"/>
      <geom name="leg_4" type="box" pos="-0.425 -0.325 -0.385" size="0.02 0.02 0.353"
            material="table_frame" class="furniture"/>
    </body>

