    <body name="cube_red" pos="0.235 0.105 0.0145">
      <freejoint name="cube_red_free"/>
      <geom class="prop" type="box" size="0.0145 0.0145 0.0145" material="cube_red"/>
    </body>

    <body name="cube_green" pos="0.295 0.025 0.0145">
      <freejoint name="cube_green_free"/>
      <geom class="prop" type="box" size="0.0145 0.0145 0.0145" material="cube_green"/>
    </body>

    <body name="cube_blue" pos="0.185 -0.075 0.0145">
      <freejoint name="cube_blue_free"/>
      <geom class="prop" type="box" size="0.0145 0.0145 0.0145" material="cube_blue"/>
    </body>

    <body name="cube_yellow" pos="0.325 0.145 0.0125">
      <freejoint name="cube_yellow_free"/>
      <geom class="prop" type="box" size="0.0125 0.0125 0.0125" material="cube_yellow"/>
    </body>

    <body name="ball" pos="0.155 0.185 0.018">
      <freejoint name="ball_free"/>
      <geom class="prop" type="sphere" size="0.018" material="ball_mat"
            friction="0.6 0.02 0.004"/>
    </body>

    <body name="can" pos="0.40 0.06 0.048">
      <freejoint name="can_free"/>
      <geom class="prop" type="cylinder" size="0.0165 0.048" material="can_mat" density="250"/>
    </body>

    <!-- Teleop target marker: shows where the IK is being asked to put the gripper.
         Visual only (no collisions, no mass) and moved from Python each step. -->
    <body name="ik_target" mocap="true" pos="0.25 0 0.12">
      <geom name="ik_target_marker" type="sphere" size="0.009" material="mat_target"
            contype="0" conaffinity="0" group="1"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- "home": arm folded up and clear of the table, jaws horizontal (which is
         how you grasp something sitting on a table) and half open -->
    <key name="home"
         qpos="0 -1.2 1.35 0.95 -1.571 0.6
               0.30 -0.155 0 1 0 0 0
               0.235 0.105 0.0145 1 0 0 0
               0.295 0.025 0.0145 1 0 0 0
               0.185 -0.075 0.0145 1 0 0 0
               0.325 0.145 0.0125 1 0 0 0
               0.155 0.185 0.018 1 0 0 0
               0.40 0.06 0.048 1 0 0 0"
         ctrl="0 -1.2 1.35 0.95 -1.571 0.6"/>
  </keyframe>
